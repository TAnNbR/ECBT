# Sepolia 测试网配置
# 复制此文件为 .env 并填入您的实际值

# Sepolia RPC URL (从 Alchemy 或 Infura 获取)
# 示例: https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY
SEPOLIA_RPC_URL=

# 部署账户的私钥 (不要包含 0x 前缀)
# 警告: 永远不要提交包含真实私钥的 .env 文件到 Git
PRIVATE_KEY=

# Etherscan API Key (用于合约验证)
# 从 https://etherscan.io/myapikey 获取
ETHERSCAN_API_KEY=
